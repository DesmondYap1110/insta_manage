# --- MySQL ---
# Laragon's default MySQL user is "root" with an empty password.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/instagram_media_manager

# --- Redis (Celery broker/result backend) ---
# Laragon bundles Redis at C:\laragon\bin\redis\redis-x64-5.0.14.1\redis-server.exe
REDIS_URL=redis://127.0.0.1:6379/0

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=changeme-generate-a-real-fernet-key

# --- Storage ---
# Absolute or relative (to backend/) path where downloaded media is stored.
MEDIA_ROOT=../media

# --- CORS ---
# Origins allowed to call the API (the Vite dev server by default).
# Add your PC's LAN IP (e.g. http://192.168.0.16:5173) if you run the
# Vite dev server and want to reach it from another device. Not needed for
# the Capacitor mobile app or a `vite build` — those hit the backend as the
# same origin, so no cross-origin request is made.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Playwright / Instagram login ---
# How long (seconds) a browser login window stays open waiting for the user to finish logging in.
LOGIN_TIMEOUT_SECONDS=300

# --- Courtesy throttling between download requests (seconds) ---
DOWNLOAD_REQUEST_DELAY_SECONDS=1.5

# --- Back-office login bootstrap ---
# Used ONLY by scripts/create_admin.py to seed/reset the admin account.
# Only the bcrypt hash is stored in MySQL; this plaintext never is.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
